# ClickHouse Cloud / ClickStack credentials. Copy to envvars.clickhouse
# (gitignored) and fill in every value.
#
# Plain KEY=VALUE lines only -- no quotes, no `export`, no other keys. deploy
# feeds this file verbatim to `kubectl create secret --from-env-file`, so quotes
# would end up inside the secret values and any extra line would become an
# extra secret key.

# HTTPS interface of the ClickHouse Cloud service, including the port.
CLICKHOUSE_ENDPOINT=https://<service-id>.us-east-1.aws.clickhouse.cloud:8443
# Database user created by sql/create-user.sql and its password.
CLICKHOUSE_USER=clickstack
CLICKHOUSE_PASSWORD=<password>
# Database the collector writes to (create-user.sql grants on it).
HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE=otel
# Shared secret the ClickStack collector requires on incoming OTLP requests
# (`authorization: <token>`). The demo's gateway collector sends it. Any long
# random string works; it never leaves the cluster.
OTLP_AUTH_TOKEN=<random-token>
