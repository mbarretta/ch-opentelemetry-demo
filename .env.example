# The launcher always pins upstream source and shop images to 3.0.0.
SHOP_PORT=8080
AGENT_HOST_PORT=8010
# Debug only: the Gradio client started by `demo.py up --debug-chatbot` listens here.
CHAT_PORT=7860

# scripted runs the real tool loop against the shop, without an LLM API key.
# live accepts free-form requests using the released ChatLLM adapter.
AGENT_MODE=scripted
MCP_ENABLED=False
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
API_KEY=
GRAPH_RECURSION_LIMIT=12

# Storefront assistant. The frontend service reads these when its container starts; they are
# not baked into the image and never reach the browser bundle.
# AGENT_BASE_URL is server-side only: the Next.js /api/assistant routes call the agent here.
AGENT_BASE_URL=http://agent:8010
# live: the panel talks to the agent through the same-origin /api/assistant routes.
# fixtures: canned answers with no agent call, for reviewing the UI.
ASSISTANT_TRANSPORT=live
# true shows scenario, prompt version, tools, and trace links under each answer.
ASSISTANT_DEMO_DETAILS=true

# Optional existing backends. With blank credentials, telemetry is captured locally.
# These URLs must be reachable FROM containers. Use host.docker.internal for host services.
CLICKSTACK_OTLP_ENDPOINT=
CLICKSTACK_API_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_PROMPT_LABEL=production

# Browser-facing URLs can differ from container-facing URLs.
LANGFUSE_PUBLIC_URL=
# Optional URL template supplied by your ClickStack deployment. {trace_id} is substituted.
CLICKSTACK_TRACE_URL_TEMPLATE=
