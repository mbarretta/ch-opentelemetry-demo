# The launcher always pins upstream source and shop images to 3.0.0.
SHOP_PORT=8080
AGENT_HOST_PORT=8010
# Debug only: the Gradio client started by `demo.py up --debug-chatbot` listens here.
CHAT_PORT=7860

# scripted runs the real tool loop against the shop, without an LLM API key.
# live accepts free-form requests using the released ChatLLM adapter.
AGENT_MODE=scripted
MCP_ENABLED=False
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
API_KEY=
GRAPH_RECURSION_LIMIT=12

# Storefront assistant. The frontend service reads these when its container starts; they are
# not baked into the image and never reach the browser bundle.
# AGENT_BASE_URL is server-side only: the Next.js /api/assistant routes call the agent here.
AGENT_BASE_URL=http://agent:8010
# live: the panel talks to the agent through the same-origin /api/assistant routes.
# fixtures: canned answers with no agent call, for reviewing the UI.
ASSISTANT_TRANSPORT=live
# Opt-in for demo runs: true shows a collapsed Demo details area under each answer with the
# scenario, prompt version and source, tool calls, and trace links, which name the Langfuse and
# ClickStack backends. Off by default so shoppers see only the answer.
ASSISTANT_DEMO_DETAILS=false

# Optional existing backends. With blank credentials, telemetry is captured locally.
# These URLs must be reachable FROM containers. Use host.docker.internal for host services.
CLICKSTACK_OTLP_ENDPOINT=
CLICKSTACK_API_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_PROMPT_LABEL=production

# Browser-facing URLs can differ from container-facing URLs.
LANGFUSE_PUBLIC_URL=
# Optional URL template supplied by your ClickStack deployment. {trace_id} is substituted.
CLICKSTACK_TRACE_URL_TEMPLATE=

# Browser session replay, recorded by the ClickStack browser SDK compiled into the frontend
# image. auto records whenever ClickStack is configured; true forces it on, false off. Read on
# both targets: the cluster's gateway collector always exports to ClickStack, so auto records
# there on every deployment, and false is applied by the next `demo.py eks deploy`.
# A recorded session carries request and response bodies and the browser console into
# ClickHouse -- the shopper's messages and the assistant's replies among them. See the README,
# "What is captured", before recording anything but synthetic demo traffic.
SESSION_REPLAY=auto

# --- EKS target ----------------------------------------------------------------------------
# Read only by `demo.py eks ...`, `demo.py publish` and `scripts/smoke.py --target eks`. The
# laptop stack ignores every key in this section: they are dropped before `docker compose` sees
# the environment.

# An IAM Identity Center (SSO) profile with access to the deployment account. Create one with:
# aws configure sso --profile <name>
AWS_PROFILE=
# Everything is deployed in one region; also change deploy/eks/tofu/terraform.tfvars to move it.
AWS_REGION=us-east-1

# The ClickHouse Cloud service the in-cluster ClickStack collector writes to. Create the user
# and grant it with deploy/eks/sql/create-user.sql, then fill in all five keys below.
# HTTPS interface of the service, including the port.
CLICKHOUSE_ENDPOINT=
# The user create-user.sql creates.
CLICKHOUSE_USER=clickstack
# That user's password.
CLICKHOUSE_PASSWORD=
# The database create-user.sql grants on and the collector writes to.
HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE=otel
# Shared secret the ClickStack collector requires on incoming OTLP requests; the demo's gateway
# collector presents it. Any long random string works; it never leaves the cluster.
OTLP_AUTH_TOKEN=

# Local port `demo.py eks tunnel` forwards the storefront to. SHOP_PORT above defaults to the
# same 8080, so change one of the two to run the laptop stack and the tunnel side by side.
EKS_TUNNEL_PORT=8080
