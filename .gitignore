.env
# No trailing slash: in a linked worktree these are symlinks to the main checkout.
.upstream
.runtime
.venv
.cache
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# OpenTofu's own working files: provider plugins, any local state, and the account-specific
# variables. Everything else the EKS target writes goes to .runtime/eks, covered above.
deploy/eks/tofu/.terraform/
deploy/eks/tofu/*.tfstate
deploy/eks/tofu/*.tfstate.*
deploy/eks/tofu/terraform.tfvars
.DS_Store

# Harness plan state: intermediate design/implementation notes, not meant for public sharing.
.claude/plans/
